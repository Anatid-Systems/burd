# Each [cids.<name>] section defines a Falcon CID.
# Add as many as you need — one per CID you want to export from or import into.
# Make sure you specifiy the correct base_url for your clients' envs. This should work automatically, but you never know.

[cids.prod-us2]
client_id = "your-client-id-here"
client_secret = "your-client-secret-here"
base_url = "https://api.us-2.crowdstrike.com"

[cids.staging]
client_id = "your-client-id-here"
client_secret = "your-client-secret-here"
base_url = "auto"  # "auto" detects the correct cloud (US-1, US-2, EU-1, GOV-1)
